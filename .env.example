# Copie para .env e ajuste:  cp .env.example .env
#
# O .env real nunca entra no git (esta' no .gitignore). Este arquivo aqui e' a lista
# de quais variaveis existem, e por isso ele acompanha o repo com valores de exemplo.
# Quem clona o projeto so' precisa copiar, trocar a senha e subir.
#
# Estas variaveis sao lidas em tres lugares: o docker-compose para criar o banco, o
# loader Python para carregar a bronze, e o dbt para se conectar. Uma fonte so',
# porque credencial repetida em dois arquivos e' credencial que um dia diverge.

# Nome do banco e do dono. Sao criados pela imagem do Postgres na primeira subida,
# e so' na primeira: se voce mudar isso depois, precisa apagar o volume (docker
# compose down -v) para valer, senao o banco antigo continua la'.
POSTGRES_DB=maintenance
POSTGRES_USER=maintenance
POSTGRES_PASSWORD=troque_esta_senha

# Onde o loader e o dbt procuram o banco. Eles rodam no seu WSL, fora do container,
# entao enxergam o Postgres pela porta publicada no host.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
